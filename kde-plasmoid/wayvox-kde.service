[Unit]
Description=Wayvox KDE D-Bus service (Language Buddy overlay)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 @WAYVOX_PROJECT_DIR@/kde-plasmoid/wayvox_kde_service.py
Restart=on-failure
RestartSec=3
Environment=DISPLAY=:0

[Install]
WantedBy=graphical-session.target
